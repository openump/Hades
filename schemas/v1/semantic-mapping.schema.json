{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:openump:schema:1.0:semantic-mapping",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "asset_id": {
      "$ref": "urn:openump:schema:1.0:common#/$defs/asset_id"
    },
    "metadata_revision": {
      "$ref": "urn:openump:schema:1.0:common#/$defs/revision"
    },
    "semantic_id": {
      "$ref": "#/$defs/semantic_id"
    },
    "dictionary": {
      "$ref": "#/$defs/dictionary"
    },
    "aas": {
      "type": "object",
      "properties": {
        "aas_id": {
          "$ref": "#/$defs/identifier"
        },
        "global_asset_id": {
          "$ref": "#/$defs/identifier"
        },
        "submodel_ids": {
          "type": "object",
          "properties": {
            "nameplate": {
              "$ref": "#/$defs/identifier"
            },
            "technical_data": {
              "$ref": "#/$defs/identifier"
            },
            "operational_data": {
              "$ref": "#/$defs/identifier"
            }
          },
          "minProperties": 1,
          "additionalProperties": false
        }
      },
      "minProperties": 1,
      "additionalProperties": false
    },
    "measurements": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 64,
      "propertyNames": {
        "$ref": "urn:openump:schema:1.0:common#/$defs/measurement_name"
      },
      "additionalProperties": {
        "$ref": "#/$defs/measurement"
      }
    }
  },
  "required": [
    "schema_version",
    "asset_id",
    "metadata_revision",
    "measurements"
  ],
  "dependentRequired": {
    "semantic_id": [
      "dictionary"
    ],
    "dictionary": [
      "semantic_id"
    ]
  },
  "additionalProperties": false,
  "$defs": {
    "semantic_id": {
      "type": "string",
      "maxLength": 256,
      "anyOf": [
        {
          "pattern": "^(irdi:)?[0-9]{4}-1#[0-9]{2}-[A-Z0-9]{6}#[0-9]{3}$(?![\\s\\S])"
        },
        {
          "pattern": "^0112/2///[0-9]{5}(_[0-9]+)?#[A-Z]{3}[0-9]{3}#[0-9]{3}$(?![\\s\\S])"
        },
        {
          "pattern": "^urn:[a-z0-9][a-z0-9-]{0,31}:[!-~]+$(?![\\s\\S])"
        },
        {
          "pattern": "^https?://[!-~]+$(?![\\s\\S])"
        }
      ]
    },
    "dictionary": {
      "enum": [
        "eclass",
        "iec_cdd",
        "opcua_companion",
        "custom_uri"
      ]
    },
    "identifier": {
      "type": "string",
      "maxLength": 2000,
      "pattern": "^(urn:[a-z0-9][a-z0-9-]{0,31}:|https?://)[!-~]+$(?![\\s\\S])"
    },
    "measurement": {
      "type": "object",
      "properties": {
        "semantic_id": {
          "$ref": "#/$defs/semantic_id"
        },
        "dictionary": {
          "$ref": "#/$defs/dictionary"
        },
        "source_tag": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\x00-\\x1f\\x7f]+$(?![\\s\\S])"
        },
        "source_unit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "pattern": "^[^\\x00-\\x1f\\x7f]+$(?![\\s\\S])"
        }
      },
      "minProperties": 1,
      "dependentRequired": {
        "semantic_id": [
          "dictionary"
        ],
        "dictionary": [
          "semantic_id"
        ]
      },
      "additionalProperties": false
    }
  }
}
