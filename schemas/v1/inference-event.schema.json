{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:openump:schema:1.0:inference-event",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "event_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$(?![\\s\\S])",
      "maxLength": 36
    },
    "timestamp": {
      "$ref": "urn:openump:schema:1.0:common#/$defs/timestamp"
    },
    "asset": {
      "$ref": "urn:openump:schema:1.0:common#/$defs/asset_id"
    },
    "inference_type": {
      "$ref": "urn:openump:schema:1.0:common#/$defs/measurement_name"
    },
    "model_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,62}[a-z0-9]$(?![\\s\\S])",
      "maxLength": 64
    },
    "model_version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,8})\\.(0|[1-9][0-9]{0,8})\\.(0|[1-9][0-9]{0,8})$(?![\\s\\S])",
      "maxLength": 32
    },
    "anomaly_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "threshold": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "severity": {
      "enum": [
        "info",
        "warning",
        "critical"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "window_start_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "window_end_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "top_contributors": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "properties": {
          "measurement": {
            "$ref": "urn:openump:schema:1.0:common#/$defs/measurement_name"
          },
          "contribution": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "required": [
          "measurement",
          "contribution"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "event_id",
    "timestamp",
    "asset",
    "inference_type",
    "model_id",
    "model_version",
    "anomaly_score",
    "threshold",
    "severity",
    "confidence",
    "window_start_ms",
    "window_end_ms",
    "top_contributors"
  ],
  "additionalProperties": false
}
