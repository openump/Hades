#!/usr/bin/env python3
"""Positive/negative mTLS, MQTT ACL, HTTP role and root-rotation checks."""
import datetime,hashlib,json,os,pathlib,ssl,subprocess,tempfile,time,urllib.request,urllib.error,urllib.parse
import socket,socketserver,struct,threading,uuid
root=pathlib.Path(__file__).resolve().parents[1];os.chdir(root)
ot_lab=os.environ.get('HADES_TEST_OT_GATEWAY')=='1'
opc_lab=os.environ.get('HADES_TEST_OPCUA')=='1'
expected_count=30 if opc_lab else 4 if ot_lab else 1
for tool in ('hades-service','hades-transfer','hades-gateway','hades-pki','hades-history-proxy','hades-normalizer','hades-history','hades-consumer'):
 subprocess.run(['go','build','-o',f'artifacts/{tool}-native',f'./cmd/{tool}'],check=True)
subprocess.run(['go','build','-o','artifacts/hades-test-receiver-native','./tests/fixtures/cloud-receiver/cmd'],check=True)
native=os.environ.get('HADES_MOSQUITTO_BINARY')
mp=os.environ.get('HADES_SECURE_MQTT_PORT','18884');hp=os.environ.get('HADES_SECURE_HISTORY_PORT','18430')
