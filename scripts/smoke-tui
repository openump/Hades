#!/bin/sh
# Drive hades-ctl top in a real pseudo-terminal: raw mode while running, and
# the terminal restored exactly on q and on SIGTERM.
set -eu
cd "$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT INT TERM
go build -o "$work/hades-ctl" ./cmd/hades-ctl
python3 -I - "$work/hades-ctl" <<'PY'
import os, pty, select, signal, sys, termios, time
binary = sys.argv[1]

def run(finish):
    pid, fd = pty.fork()
    if pid == 0:
        # Port 1 on loopback is closed: exercises the DAEMON UNREACHABLE banner.
        os.execv(binary, [binary, 'top', '-inspector', '127.0.0.1:1', '-interval', '200ms'])
    before = termios.tcgetattr(fd)
    out = b''
    def pump(seconds):
        nonlocal out
        end = time.time() + seconds
        while time.time() < end:
            ready, _, _ = select.select([fd], [], [], 0.05)
            if ready:
                try:
                    out += os.read(fd, 65536)
                except OSError:
                    return
    pump(1.0)
    during = termios.tcgetattr(fd)
    for key in [b'2', b'/', b'm', b'o', b'\r']:
        os.write(fd, key)
        pump(0.2)
    if finish == 'q':
        os.write(fd, b'q')
    else:
        os.kill(pid, signal.SIGTERM)
    pump(1.0)
    _, status = os.waitpid(pid, 0)
    after = termios.tcgetattr(fd)
    text = out.decode('utf-8', 'replace')
    checks = {
        'exit 0': os.waitstatus_to_exitcode(status) == 0,
        'raw mode while running': not (during[3] & termios.ECHO) and not (during[3] & termios.ICANON),
        'terminal attributes restored': after == before,
        'alternate screen left': '\x1b[?1049l' in text[-64:],
        'cursor shown': '\x1b[?25h' in text[-64:],
        'unreachable banner': 'DAEMON UNREACHABLE' in text,
        'pane switch': '2 UNS telemetry' in text,
        'filter typed': 'filter: mo' in text,
    }
    failed = [name for name, ok in checks.items() if not ok]
    assert not failed, (finish, failed)

run('q')
run('sigterm')
print('tui: hades-ctl top raw mode, navigation, unreachable banner and terminal restoration on q and SIGTERM passed')
PY
