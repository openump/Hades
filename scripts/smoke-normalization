#!/usr/bin/env python3
"""Development check only: Go normalizer -> MQTT -> validating Go consumer."""
import json, os, pathlib, subprocess, tempfile, time, urllib.request, urllib.error
root=pathlib.Path(__file__).resolve().parents[1]
os.chdir(root)
for tool in ('hades-normalizer','hades-consumer'):
 subprocess.run(['go','build','-o',f'artifacts/{tool}',f'./cmd/{tool}'],check=True)
port=os.environ.get('HADES_MQTT_PORT','1883')
with tempfile.TemporaryDirectory(prefix='hades-normalization-') as scratch:
 out=open(scratch+'/consumer.jsonl','w');err=open(scratch+'/logs','w');children=[]
 try:
  consumer=subprocess.Popen(['artifacts/hades-consumer','-broker',f'mqtt://127.0.0.1:{port}','-count','2','-timeout','30s'],stdout=out,stderr=err);children.append(consumer)
  for _ in range(100):
   if '"type":"ready"' in pathlib.Path(out.name).read_text():break
   if consumer.poll() is not None:raise RuntimeError(pathlib.Path(err.name).read_text())
   time.sleep(.1)
  else:raise RuntimeError('consumer never ready')
  normalizer=subprocess.Popen(['artifacts/hades-normalizer','-broker',f'mqtt://127.0.0.1:{port}','-listen','127.0.0.1:18081','-quarantine',scratch+'/quarantine'],stdout=err,stderr=err);children.append(normalizer)
  for _ in range(100):
   try:urllib.request.urlopen('http://127.0.0.1:18081/health',timeout=1);break
   except OSError:time.sleep(.1)
  else:raise RuntimeError(pathlib.Path(err.name).read_text())
  def post(raw,code):
   request=urllib.request.Request('http://127.0.0.1:18081/observations',data=raw,headers={'Content-Type':'application/json'})
   try:
    response=urllib.request.urlopen(request,timeout=5);actual=response.status
    if actual==202:assert json.load(response)['acceptance']=='accepted_broker_ack'
   except urllib.error.HTTPError as failure:actual=failure.code
   assert actual==code,(actual,code)
  fixture=json.loads(pathlib.Path('examples/raw-observations/valid.json').read_text())
  invalid=json.loads(json.dumps(fixture));invalid['signals']['temperature']['unit']='K'
  post(b'{',400);post(b'x'*65537,413);post(json.dumps(invalid).encode(),422)
  post(json.dumps(fixture).encode(),202)
  missing=json.loads(json.dumps(fixture));missing['message_id']='019a1234-5678-7000-8000-000000000022'
  missing['source']['sequence']=2;missing['signals']['temperature']={'value':None,'unit':'deciCel','quality':'bad','reason':'timeout'}
  post(json.dumps(missing).encode(),202)
  assert consumer.wait(timeout=30)==0,pathlib.Path(err.name).read_text()
  events=[json.loads(line) for line in pathlib.Path(out.name).read_text().splitlines()]
  readings=[e for e in events if e['type']=='telemetry']
  assert len(readings)==2
  for event,expected in zip(readings,(fixture,missing)):
   assert event['message_id']==expected['message_id']
   assert event['payload']['source']==expected['source']
   assert event['observed_at']==expected['observed_at']
  assert readings[0]['value']==67.2 and readings[1]['value'] is None and readings[1]['quality']=='bad'
  health=json.load(urllib.request.urlopen('http://127.0.0.1:18081/health'))
  assert health['quarantine_records']==3 and health['published']==2,health
  assert pathlib.Path(scratch+'/quarantine').stat().st_mode&0o777==0o700
  print('normalization: valid/scaling/missing + malformed/oversized/unit quarantine passed')
 finally:
  for child in children:
   if child.poll() is None:child.terminate()
  for child in children:
   try:child.wait(timeout=10)
   except subprocess.TimeoutExpired:child.kill();child.wait()
  out.close();err.close()
