#!/bin/sh
set -eu
cd "$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
compose() { docker compose -f deploy/compose.yaml "$@"; }
work=$(mktemp -d)
consumer=''
producer=''
cleanup() {
  if [ -n "$consumer" ]; then kill "$consumer" 2>/dev/null || true; fi
  if [ -n "$producer" ]; then kill "$producer" 2>/dev/null || true; fi
  rm -rf "$work"
}
trap cleanup EXIT INT TERM
mkdir -p artifacts
go build -o artifacts/hades-consumer ./cmd/hades-consumer
go build -o artifacts/hades-simulator ./cmd/hades-simulator
go build -o artifacts/hades-check ./cmd/hades-check
broker="mqtt://127.0.0.1:${HADES_MQTT_PORT:-1883}"
artifacts/hades-consumer -broker "$broker" -count 15 -timeout 60s > "$work/consumer.jsonl" 2> "$work/consumer.err" &
consumer=$!
wait_for() {
  tries=0
  until grep -q "$1" "$2"; do
    tries=$((tries+1))
    if [ "$tries" -ge 100 ]; then printf 'readiness timeout waiting for %s\n' "$1"; cat "$work/consumer.err"; cat "$work/producer.err" 2>/dev/null || true; return 1; fi
    sleep 0.1
  done
}
wait_for '"type":"ready"' "$work/consumer.jsonl"
artifacts/hades-simulator -broker "$broker" -scenario cycle -count 15 -timeout 60s > "$work/producer.jsonl" 2> "$work/producer.err" &
producer=$!
wait_for '"type":"telemetry"' "$work/consumer.jsonl"
wait_for '"type":"published"' "$work/producer.jsonl"
python3 - "$work" <<'PY'
import json,sys
from pathlib import Path
p=Path(sys.argv[1]);first=json.loads(p.joinpath('producer.jsonl').read_text().splitlines()[0])['payload']
p.joinpath('duplicate.json').write_bytes(json.dumps(first,separators=(',',':')).encode())
PY
compose exec -T broker mosquitto_pub -h 127.0.0.1 -V mqttv5 -q 1 -t openump/v1/acme/berlin/assembly/line-01/press-04/telemetry -s < "$work/duplicate.json"
wait_for '"duplicate":true' "$work/consumer.jsonl"
compose restart broker
compose up -d --wait --wait-timeout 60
if ! wait "$producer"; then cat "$work/producer.err"; exit 1; fi
producer=''
if ! wait "$consumer"; then cat "$work/consumer.err"; exit 1; fi
consumer=''
python3 - "$work" <<'PY'
import json,subprocess,sys
from pathlib import Path
p=Path(sys.argv[1]);rows=[json.loads(x) for x in p.joinpath('consumer.jsonl').read_text().splitlines()]
produced=[json.loads(x)['payload'] for x in p.joinpath('producer.jsonl').read_text().splitlines()]
telemetry=[r for r in rows if r['type']=='telemetry'];unique=[r for r in telemetry if not r['duplicate']]
assert len(unique)==15 and any(r['duplicate'] for r in telemetry)
assert any(r['type']=='ready' and r.get('reconnected') for r in rows)
assert {r['type'] for r in rows}>={'metadata','status','telemetry'}
assert {r['quality'] for r in unique}=={'good','bad'}
assert any(r['value'] is None and r['quality']=='bad' for r in unique)
assert {r['unit'] for r in unique}=={'Cel'}
assert {r['message_id'] for r in unique}=={r['message_id'] for r in produced}
by_id={r['message_id']:r for r in produced}
for row in rows:
 if 'payload' not in row:continue
 raw=p/'check.json';raw.write_text(json.dumps(row['payload']))
 subprocess.run(['artifacts/hades-check','-kind',row['type'],'-file',str(raw)],check=True,stdout=subprocess.DEVNULL)
 if row['type']=='telemetry':
  assert row['observed_at']==by_id[row['message_id']]['observed_at']
print('simulator smoke passed: fifteen unique observations, duplicate handling, metadata/status, null bad reading, restart/reconnect, schema validation')
PY
