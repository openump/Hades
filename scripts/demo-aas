#!/bin/sh
# Visual and video verification of the standards boundary (Hades-046):
# hades import, hades check and hades aas export run from the committed
# storyboard (tests/visual/aas/storyboard.json), captured and compared with
# reviewed baselines, shown in Eclipse BaSyx (pinned test fixture,
# deploy/basyx), projected live from a `hades up` demo stack, and assembled
# into the captioned demo video. Everything goes to artifacts/aas.
#
#   scripts/demo-aas              # Linux: pinned container browser, compared, video built
#   scripts/demo-aas --preview    # any OS: local Chrome, not compared, video built
#   scripts/demo-aas --refresh    # accept captures as baselines and refresh docs/assets/aas-demo.*
#
# The storyboard uses fixed loopback ports: BaSyx 18471 (API) and 18472 (UI),
# the demo broker 18981 and historian 18988.
set -eu
cd "$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
out=artifacts/aas
mode=compare
case "${1:-}" in
  --preview) mode=preview ;;
  --refresh) mode=refresh ;;
  "") ;;
  *) echo "usage: scripts/demo-aas [--preview|--refresh]" >&2; exit 2 ;;
esac
browser=container
if [ "$mode" = preview ] || [ "$(uname -s)" != Linux ]; then
  browser=host
  # Baselines and the committed video come only from the pinned browser.
  [ "$mode" = refresh ] && { echo "--refresh needs the pinned browser on Linux (CI); refusing to write baselines from local Chrome" >&2; exit 2; }
  [ "$mode" = compare ] && { echo "baselines are compared only with the pinned browser on Linux; running a preview" >&2; mode=preview; }
fi
rm -rf "$out" && mkdir -p "$out"
work=$(mktemp -d)
up=''
compose="docker compose -f deploy/basyx/compose.yaml"
cleanup() {
  if [ -n "$up" ]; then kill -TERM "$up" 2>/dev/null || true; wait "$up" 2>/dev/null || true; fi
  $compose down -v >/dev/null 2>&1 || true
  rm -rf "$work"
}
trap cleanup EXIT
trap 'cleanup; exit 130' INT TERM

mkdir -p "$work/bin"
go build -o "$work/bin/hades" ./cmd/hades
go build -o "$work/bin/uns-snapshot" ./tests/visual/snapshot

# The independent AAS implementation.
$compose pull -q
$compose up -d >/dev/null
wait_http() {
  for _ in $(seq 1 120); do
    curl -sf -o /dev/null "$1" && return 0
    sleep 1
  done
  echo "$2 did not come up at $1" >&2
  $compose logs --tail 50 >&2 || true
  exit 1
}
wait_http http://127.0.0.1:18471/shells "BaSyx AAS environment"
wait_http http://127.0.0.1:18472/ "BaSyx web UI"

# The live edge stack.
"$work/bin/hades" init -profile demo -out-dir "$work/site" -mqtt-port 18981 -historian-port 18988 >/dev/null
"$work/bin/hades" up -site-dir "$work/site" -interval 1s > "$work/up.jsonl" 2>&1 &
up=$!
for _ in $(seq 1 240); do
  grep -q '"site_up"' "$work/up.jsonl" && break
  kill -0 "$up" 2>/dev/null || { cat "$work/up.jsonl" >&2; exit 1; }
  sleep 1
done
grep -q '"site_up"' "$work/up.jsonl" || { echo "demo stack did not come up" >&2; exit 1; }

set -- -suite aas -browser "$browser" -out "$out" -work "$work/run" -bin "$work/bin" \
  -basyx-api http://127.0.0.1:18471 -basyx-ui http://127.0.0.1:18472 -live-site "$work/site" -video
case "$mode" in
  preview) set -- "$@" -compare=false ;;
  refresh) set -- "$@" -refresh ;;
esac
go run ./tests/visual "$@"
