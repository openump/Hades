#!/bin/sh
# Air-gapped factory bundle: hades-airgap-<version>-<arch>.tar.zst holding the
# signed release artifacts for one architecture, the runtime images saved with
# `docker save`, the reference Compose files and install-offline.sh. Every file
# is listed in a checksums.txt signed with the Ed25519 release key, and each
# image's content ID is recorded, so the offline installer can verify all of it
# with zero network access.
#
#   HADES_VERSION=1.0.0 HADES_RELEASE_KEY=/secure/release.key HADES_ARCH=amd64 \
#     scripts/build-airgap-bundle dist/
set -eu
cd "$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
dist=$(CDPATH= cd -- "${1:?release dist directory from scripts/package-release}" && pwd)
version=${HADES_VERSION:?set HADES_VERSION}
key=${HADES_RELEASE_KEY:?set HADES_RELEASE_KEY}
arch=${HADES_ARCH:-amd64}
case "$arch" in amd64|arm64) ;; *) echo "HADES_ARCH must be amd64 or arm64" >&2; exit 2 ;; esac
command -v zstd >/dev/null || { echo "zstd is required" >&2; exit 1; }
# The release must verify before anything from it is bundled.
go run ./cmd/hades release verify -dir "$dist" -pub "${HADES_RELEASE_PUB:?set HADES_RELEASE_PUB to the release public key}"
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT INT TERM
name="hades-airgap-${version}-${arch}"
b="$work/$name"; mkdir -p "$b/images" "$b/deploy"
for f in "hades_${version}_linux_${arch}.deb" "hades_${version}_linux_${arch}.rpm" "hades_${version}_linux_${arch}.tar.gz" "hades_${version}_linux_${arch}.sbom.cdx.json" install.sh; do
  cp "$dist/$f" "$b/"
done
cp "$b/hades_${version}_linux_${arch}.sbom.cdx.json" "$b/sbom.cdx.json"
# Runtime images for the reference stack, built for the target architecture
# from the pinned Dockerfiles (they are not published to a registry).
export DOCKER_DEFAULT_PLATFORM="linux/$arch"
go build -o "$work/hades-tool" ./cmd/hades
GOOS=linux GOARCH=$arch CGO_ENABLED=0 go build -trimpath -o artifacts/hades-history-proxy ./cmd/hades-history-proxy
# Building needs no credentials; the compose file only requires the variable.
HADES_SECURITY_DIR="$work/no-credentials" docker compose -f deploy/compose.secure.yaml build broker historian history-proxy >/dev/null
alpine=alpine:3.24@sha256:294b683cb724975bec92580e1e685676bd4b50bda910ddb8c51d4cabeaec77e6
docker pull -q --platform "linux/$arch" "$alpine" >/dev/null
: > "$b/images.txt"
for image in openump/hades-mosquitto:2.1.2-dev openump/hades-victoriametrics:1.154.0-dev openump/hades-history-proxy:dev "$alpine"; do
  file=$(echo "$image" | sed 's#[/:@]#_#g').tar
  docker save "$image" -o "$b/images/$file"
  printf '%s %s %s\n' "$(docker image inspect --format '{{.Id}}' "$image")" "$image" "images/$file" >> "$b/images.txt"
done
# Same layout as the repository, so the Compose file's ../config mounts resolve.
cp deploy/compose.secure.yaml "$b/deploy/"
cp -R config "$b/config"
cp scripts/install-offline.sh "$b/install-offline.sh"
chmod 0755 "$b/install-offline.sh"
# For reference only (signed with the rest); install-offline.sh never trusts it.
"$work/hades-tool" release pubkey -key "$key" > "$b/release.pub"
# Sign every file in the bundle (paths relative to the bundle root).
sha256() { if command -v sha256sum >/dev/null 2>&1; then sha256sum "$1" | cut -d' ' -f1; else shasum -a 256 "$1" | cut -d' ' -f1; fi; }
( cd "$b" && find . -type f ! -name checksums.txt ! -name checksums.txt.sig | sed 's#^\./##' | LC_ALL=C sort \
    | while read -r f; do printf '%s  %s\n' "$(sha256 "$f")" "$f"; done > checksums.txt )
grep -qv '^[0-9a-f]\{64\}  ' "$b/checksums.txt" && { echo "empty or malformed checksum line" >&2; exit 1; }
"$work/hades-tool" release sign-file -file "$b/checksums.txt" -key "$key"
tar -C "$work" -cf - "$name" | zstd -q -f -19 -T0 -o "$dist/$name.tar.zst"
echo "bundle: $dist/$name.tar.zst ($(du -h "$dist/$name.tar.zst" | cut -f1))"
